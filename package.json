{
  "name": "playwright-js-e2e-framework",
  "version": "1.0.0",
  "description": "Playwright JavaScript end-to-end automation framework using the Sauce Demo application.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "cross-env ENV=qa playwright test --project=chromium",
    "test:staging": "cross-env ENV=staging playwright test --project=chromium",
    "test:headed": "cross-env ENV=qaa playwright test --project=chromium --headed",
    "test:debug": "cross-env ENV=qa playwright test --project=chromium --debug",
    "test:firefox": "cross-env ENV=qa playwright test --project=firefox",
    "test:webkit": "cross-env ENV=qa playwright test --project=webkit",
    "test:browsers": "cross-env ENV=qa playwright test"
  },
  "keywords": [
    "playwright",
    "javascript",
    "e2e",
    "test-automation"
  ],
  "author": "Ali Hashmi",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3"
  }
}
